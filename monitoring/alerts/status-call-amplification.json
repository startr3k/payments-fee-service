{
  "size": 0,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        {"term": {"_index": "paynow-gateway-access"}},
        {"range": {"@timestamp": {"gte": "2026-11-03T05:30:00Z", "lt": "2026-11-03T11:25:00Z"}}}
      ]
    }
  },
  "aggs": {
    "baseline_quiet_05_30_to_10_30Z": {
      "filter": {"range": {"@timestamp": {"gte": "2026-11-03T05:30:00Z", "lt": "2026-11-03T10:30:00Z"}}},
      "aggs": {
        "status_calls": {"filter": {"bool": {"filter": [{"term": {"caller": "paynow-status-service"}}, {"wildcard": {"route": "*status*"}}]}}},
        "submission_requests": {"filter": {"bool": {"filter": [{"term": {"caller": "paynow-payment-service"}}, {"term": {"route": "/v1/payments"}}]}}}
      }
    },
    "buckets_5m": {
      "date_histogram": {
        "field": "@timestamp",
        "fixed_interval": "5m",
        "time_zone": "UTC",
        "min_doc_count": 0,
        "extended_bounds": {"min": "2026-11-03T05:30:00Z", "max": "2026-11-03T11:20:00Z"}
      },
      "aggs": {
        "status_calls": {"filter": {"bool": {"filter": [{"term": {"caller": "paynow-status-service"}}, {"wildcard": {"route": "*status*"}}]}}},
        "submission_requests": {"filter": {"bool": {"filter": [{"term": {"caller": "paynow-payment-service"}}, {"term": {"route": "/v1/payments"}}]}}},
        "status_per_submission": {
          "bucket_script": {
            "buckets_path": {"c": "status_calls>_count", "s": "submission_requests>_count"},
            "script": "params.s > 0 ? (double) params.c / params.s : 0.0"
          }
        },
        "exceeds_2x_baseline": {
          "bucket_script": {
            "buckets_path": {"c": "status_calls>_count", "s": "submission_requests>_count"},
            "script": "(params.s > 0 && params.c > 5.0294 * params.s) ? 1 : 0"
          }
        }
      }
    }
  }
}
