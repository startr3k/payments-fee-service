{
  "permissionRules": {
    "version": 1,
    "rules": [
      {
        "id": "bank/kubectl-prod-mutations-blocked",
        "decision": "block",
        "reason": "Production mutations go through the pipeline only. No agent, human or otherwise, mutates prod with kubectl directly. Change-advisory policy PAY-OPS-12.",
        "match": {
          "prefix": [
            "kubectl",
            ["delete", "rollout", "scale", "apply", "patch", "replace", "edit", "label", "annotate", "drain", "cordon"]
          ]
        },
        "tests": {
          "match": [
            "kubectl rollout undo deployment/paynow-status-service -n prod-sg",
            "kubectl scale deployment/paynow-status-service --replicas=2 -n prod-sg"
          ],
          "noMatch": ["kubectl get pods -n prod-sg", "kubectl logs paynow-status-service-7d9f -n prod-sg"]
        }
      },
      {
        "id": "bank/kubectl-read-only-allow",
        "decision": "allow",
        "reason": "Incident investigation needs live cluster state; reads are unrestricted.",
        "match": { "prefix": ["kubectl", ["get", "describe", "logs", "top", "explain"]] },
        "tests": {
          "match": ["kubectl get pods -n prod-sg -o wide"],
          "noMatch": ["kubectl delete pod paynow-status-service-7d9f -n prod-sg"]
        }
      },
      {
        "id": "bank/git-force-push-blocked",
        "decision": "block",
        "reason": "Published history is never rewritten.",
        "match": { "prefix": ["git", "push", ["--force", "-f", "--force-with-lease"]] },
        "tests": {
          "match": ["git push --force origin main", "git push -f origin fix/status-backoff"],
          "noMatch": ["git push origin fix/status-backoff"]
        }
      },
      {
        "id": "bank/git-push-main-blocked",
        "decision": "block",
        "reason": "main changes only through a reviewed pull request.",
        "match": { "prefix": ["git", "push", "origin", ["main", "HEAD:main"]] },
        "tests": {
          "match": ["git push origin main", "git push origin HEAD:main"],
          "noMatch": ["git push origin fix/status-backoff", "git push -u origin fix/status-backoff"]
        }
      },
      {
        "id": "bank/terraform-destroy-blocked",
        "decision": "block",
        "reason": "Infrastructure destruction is never an agent action; IaC changes land via reviewed PR + pipeline.",
        "match": { "prefix": ["terraform", "destroy"] },
        "tests": { "match": ["terraform destroy -auto-approve"], "noMatch": ["terraform plan"] }
      }
    ]
  }
}
